<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopiva Kenya | Smart Shopping Marketplace</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #172033;
            line-height: 1.5;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .navbar {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1200px;
            margin: auto;
            min-height: 72px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .logo {
            font-size: 26px;
            font-weight: 800;
            color: #2563eb;
            white-space: nowrap;
        }

        .logo span {
            color: #111827;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 18px;
            font-size: 15px;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: #2563eb;
        }

        .cart-btn {
            background: #2563eb;
            color: white !important;
            padding: 10px 16px;
            border-radius: 10px;
        }

        .hero {
            max-width: 1200px;
            margin: 28px auto;
            padding: 55px 35px;
            border-radius: 24px;
            background: linear-gradient(135deg, #172554, #2563eb);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            overflow: hidden;
        }

        .hero-content {
            max-width: 650px;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.25);
            padding: 7px 13px;
            border-radius: 30px;
            margin-bottom: 15px;
            font-size: 13px;
            font-weight: bold;
        }

        .hero h1 {
            font-size: clamp(35px, 6vw, 64px);
            line-height: 1.05;
            margin-bottom: 18px;
        }

        .hero p {
            font-size: 18px;
            opacity: .92;
            margin-bottom: 28px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .primary-btn,
        .secondary-btn {
            display: inline-block;
            padding: 13px 21px;
            border-radius: 10px;
            font-weight: 700;
        }

        .primary-btn {
            background: white;
            color: #1d4ed8;
        }

        .secondary-btn {
            border: 1px solid rgba(255,255,255,.4);
            color: white;
        }

        .hero-icon {
            font-size: 130px;
            opacity: .18;
        }

        .section {
            max-width: 1200px;
            margin: 45px auto;
            padding: 0 20px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 15px;
        }

        .section-header h2 {
            font-size: 28px;
        }

        .section-header p {
            color: #64748b;
            font-size: 14px;
        }

        .categories {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .category {
            background: white;
            border: 1px solid #e5e7eb;
            padding: 24px;
            border-radius: 16px;
            text-align: center;
            transition: .2s;
        }

        .category:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15,23,42,.08);
        }

        .category-icon {
            font-size: 34px;
            margin-bottom: 10px;
        }

        .category h3 {
            font-size: 16px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            overflow: hidden;
            transition: .2s;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(15,23,42,.09);
        }

        .product-image {
            height: 190px;
            background: linear-gradient(135deg, #dbeafe, #eff6ff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 60px;
        }

        .product-info {
            padding: 17px;
        }

        .product-name {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .product-description {
            color: #64748b;
            font-size: 13px;
            min-height: 40px;
            margin-bottom: 12px;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .price {
            color: #2563eb;
            font-size: 18px;
            font-weight: 800;
        }

        .view-btn {
            background: #eff6ff;
            color: #1d4ed8;
            padding: 8px 11px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
        }

        .empty-products {
            background: white;
            border: 1px dashed #cbd5e1;
            padding: 40px;
            border-radius: 16px;
            text-align: center;
            color: #64748b;
        }

        .benefits {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .benefit {
            background: white;
            padding: 22px;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
        }

        .benefit-icon {
            font-size: 28px;
            margin-bottom: 10px;
        }

        .benefit h3 {
            margin-bottom: 6px;
            font-size: 16px;
        }

        .benefit p {
            color: #64748b;
            font-size: 13px;
        }

        footer {
            margin-top: 60px;
            background: #111827;
            color: white;
            padding: 35px 20px;
        }

        .footer-container {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-title {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .footer-text {
            color: #cbd5e1;
            font-size: 14px;
        }

        @media (max-width: 900px) {
            .products {
                grid-template-columns: repeat(2, 1fr);
            }

            .categories,
            .benefits {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero-icon {
                display: none;
            }
        }

        @media (max-width: 650px) {
            .nav-container {
                min-height: auto;
                padding: 15px;
                flex-wrap: wrap;
            }

            .nav-links {
                width: 100%;
                justify-content: space-between;
                gap: 8px;
                font-size: 13px;
            }

            .hero {
                margin: 15px;
                padding: 35px 22px;
            }

            .hero p {
                font-size: 16px;
            }

            .products,
            .categories,
            .benefits {
                grid-template-columns: 1fr;
            }

            .section {
                margin: 35px auto;
            }
        }
    </style>
</head>

<body>

<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="logo">Shopiva<span> Kenya</span></a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="#products">Products</a>
            <a href="#categories">Categories</a>
            <a href="/cart/" class="cart-btn">🛒 Cart</a>
        </div>
    </div>
</nav>

<section class="hero">
    <div class="hero-content">
        <span class="hero-badge">🇰🇪 Built for Kenya</span>

        <h1>Shop smarter.<br>Live better.</h1>

        <p>
            Discover quality products, compare your options,
            and enjoy a simple shopping experience with Shopiva.
        </p>

        <div class="hero-buttons">
            <a href="#products" class="primary-btn">Shop Products</a>
            <a href="#categories" class="secondary-btn">Explore Categories</a>
        </div>
    </div>

    <div class="hero-icon">🛍️</div>
</section>

<section class="section" id="categories">
    <div class="section-header">
        <div>
            <h2>Shop by category</h2>
            <p>Explore popular shopping categories</p>
        </div>
    </div>

    <div class="categories">
        <div class="category">
            <div class="category-icon">📱</div>
            <h3>Electronics</h3>
        </div>

        <div class="category">
            <div class="category-icon">👕</div>
            <h3>Fashion</h3>
        </div>

        <div class="category">
            <div class="category-icon">🏠</div>
            <h3>Home & Living</h3>
        </div>

        <div class="category">
            <div class="category-icon">🛒</div>
            <h3>More Products</h3>
        </div>
    </div>
</section>

<section class="section" id="products">
    <div class="section-header">
        <div>
            <h2>Featured products</h2>
            <p>Products currently available on Shopiva</p>
        </div>
    </div>

    {% if products %}
    <div class="products">

        {% for product in products %}

        <article class="product-card">

            <div class="product-image">
                🛍️
            </div>

            <div class="product-info">

                <div class="product-name">
                    {{ product.name }}
                </div>

                <div class="product-description">
                    {{ product.description|truncatechars:80 }}
                </div>

                <div class="product-bottom">

                    <span class="price">
                        KSh {{ product.price }}
                    </span>

                    <a
                        href="{% url 'product_detail' product.id %}"
                        class="view-btn">
                        View
                    </a>

                </div>

            </div>

        </article>

        {% endfor %}

    </div>

    {% else %}

    <div class="empty-products">
        <h3>No products available yet</h3>
        <p>Products added through the Shopiva system will appear here.</p>
    </div>

    {% endif %}
</section>

<section class="section">

    <div class="section-header">
        <div>
            <h2>Why Shopiva?</h2>
            <p>A marketplace designed around a simple shopping experience.</p>
        </div>
    </div>

    <div class="benefits">

        <div class="benefit">
            <div class="benefit-icon">🔒</div>
            <h3>Secure shopping</h3>
            <p>Your shopping journey is designed with security in mind.</p>
        </div>

        <div class="benefit">
            <div class="benefit-icon">⚡</div>
            <h3>Simple checkout</h3>
            <p>Move from product selection to checkout with fewer steps.</p>
        </div>

        <div class="benefit">
            <div class="benefit-icon">📦</div>
            <h3>Order tracking</h3>
            <p>Keep your orders organized from checkout onward.</p>
        </div>

        <div class="benefit">
            <div class="benefit-icon">🇰🇪</div>
            <h3>Made for Kenya</h3>
            <p>A marketplace experience designed for Kenyan shoppers.</p>
        </div>

    </div>

</section>

<footer>
    <div class="footer-container">

        <div>
            <div class="footer-title">Shopiva Kenya</div>
            <div class="footer-text">
                Your modern online marketplace.
            </div>
        </div>

        <div class="footer-text">
            © 2026 Shopiva Kenya. All rights reserved.
        </div>

    </div>
</footer>

</body>
</html>
